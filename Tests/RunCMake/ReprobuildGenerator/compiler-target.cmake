# Run the generator's actual inline compiler actions, without a provider or
# scheduler: this isolates compiler argv lowering and uses real Clang and lld
# cross-compiles/links. No compiler or linker is mocked. Forced compiler checks
# avoid needing a foreign SDK just to configure the freestanding test project.
cmake_minimum_required(VERSION 3.29)
foreach(required IN ITEMS TEST_CMAKE TEST_CLANG TEST_BINARY_ROOT)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()
file(REMOVE_RECURSE "${TEST_BINARY_ROOT}")
# A PATH containing only real tool symlinks keeps an installed repro daemon
# from priming the provider. Provider execution is outside this argv test.
set(tool_path "${TEST_BINARY_ROOT}/tools")
file(MAKE_DIRECTORY "${tool_path}")
foreach(tool IN ITEMS ld.lld ar ranlib make)
  find_program(tool_${tool} NAMES ${tool} REQUIRED)
  file(CREATE_LINK "${tool_${tool}}" "${tool_path}/${tool}" SYMBOLIC)
endforeach()
set(tool_env "${CMAKE_COMMAND}" -E env --unset=REPROBUILD_REPRO "PATH=${tool_path}")
set(source "${TEST_BINARY_ROOT}/src")
file(MAKE_DIRECTORY "${source}")
file(WRITE "${source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.29)
project(CompilerTarget C CXX)
foreach(lang IN ITEMS C CXX)
  if(OPTION_SHAPE STREQUAL "separate")
    set(CMAKE_${lang}_COMPILE_OPTIONS_TARGET "-target ")
  elseif(OPTION_SHAPE STREQUAL "no-option")
    set(CMAKE_${lang}_COMPILE_OPTIONS_TARGET "")
  elseif(OPTION_SHAPE STREQUAL "no-target")
    set(CMAKE_${lang}_COMPILER_TARGET "")
  endif()
  if(lang STREQUAL "C")
    set(ext c)
  else()
    set(ext cxx)
  endif()
  add_executable(app_${lang} main.${ext})
  add_library(shared_${lang} SHARED main.${ext})
  add_library(module_${lang} MODULE main.${ext})
  add_library(archive_${lang} STATIC main.${ext})
  if(USE_RESPONSE)
    foreach(i RANGE 1 100)
      foreach(t IN ITEMS app_${lang} shared_${lang} module_${lang} archive_${lang})
        target_compile_definitions(${t} PRIVATE PADDING_DEFINITION_${i}=1)
        target_link_options(${t} PRIVATE -Wl,--defsym,padding_symbol_${i}=0)
      endforeach()
    endforeach()
  endif()
endforeach()
]=])
foreach(ext IN ITEMS c cxx)
  file(WRITE "${source}/main.${ext}" [=[
#if REQUIRE_AARCH64 && !defined(__aarch64__)
# error compiler target was not passed
#endif
int main(void) { return 0; }
]=])
endforeach()
foreach(shape IN ITEMS joined separate no-option no-target)
  foreach(response IN ITEMS OFF ON)
    set(binary "${TEST_BINARY_ROOT}/${shape}-${response}")
    execute_process(COMMAND ${tool_env} "${TEST_CMAKE}" -S "${source}" -B "${binary}" -G Reprobuild
      "-DCMAKE_MAKE_PROGRAM=${tool_path}/make"
      "-DCMAKE_C_COMPILER=${TEST_CLANG}" "-DCMAKE_CXX_COMPILER=${TEST_CLANG}"
      -DCMAKE_C_COMPILER_FORCED=TRUE -DCMAKE_CXX_COMPILER_FORCED=TRUE
      -DCMAKE_SYSTEM_NAME=Linux -DCMAKE_SYSTEM_PROCESSOR=aarch64
      -DCMAKE_C_COMPILER_TARGET=aarch64-unknown-linux-gnu
      -DCMAKE_CXX_COMPILER_TARGET=aarch64-unknown-linux-gnu
      "-DOPTION_SHAPE=${shape}" "-DUSE_RESPONSE=${response}"
      -DCMAKE_C_FLAGS=-DREQUIRE_AARCH64=1 -DCMAKE_CXX_FLAGS=-DREQUIRE_AARCH64=1
      "-DCMAKE_EXE_LINKER_FLAGS=-nostdlib -fuse-ld=lld -Wl,-e,main"
      "-DCMAKE_SHARED_LINKER_FLAGS=-nostdlib -fuse-ld=lld"
      "-DCMAKE_MODULE_LINKER_FLAGS=-nostdlib -fuse-ld=lld"
      RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "${shape}/${response} configure failed: ${out}\n${err}")
    endif()
    file(READ "${binary}/reprobuild.nim" provider)
    string(REGEX MATCHALL "inlineExecCall\\(@\\[[^\n]*\\], cwd =" calls "${provider}")
    set(count 0)
    foreach(call IN LISTS calls)
      string(REGEX REPLACE "^inlineExecCall\\(@(\\[.*\\]), cwd =$" "\\1" argv_json "${call}")
      string(JSON length LENGTH "${argv_json}")
      math(EXPR last "${length} - 1")
      set(argv)
      foreach(i RANGE 0 ${last})
        string(JSON arg GET "${argv_json}" ${i})
        list(APPEND argv "${arg}")
      endforeach()
      # Only compiler actions, excluding the generated regeneration action.
      list(GET argv 0 exe)
      if(NOT exe STREQUAL TEST_CLANG)
        if(call MATCHES "aarch64-unknown-linux-gnu")
          message(FATAL_ERROR "Compiler target leaked into a non-compiler action: ${call}")
        endif()
        continue()
      endif()
      math(EXPR count "${count} + 1")
      set(args "${argv}")
      foreach(arg IN LISTS argv)
        if(arg MATCHES "^@(.+)")
          file(READ "${binary}/${CMAKE_MATCH_1}" rsp)
          string(APPEND args "${rsp}")
        endif()
      endforeach()
      if(shape MATCHES "^no-")
        if(args MATCHES "aarch64-unknown-linux-gnu")
          message(FATAL_ERROR "${shape}: target passed without both target and option: ${args}")
        endif()
      else()
        if(NOT args MATCHES "aarch64-unknown-linux-gnu")
          message(FATAL_ERROR "${shape}/${response}: compiler target missing: ${argv}")
        endif()
        execute_process(COMMAND ${tool_env} ${argv} WORKING_DIRECTORY "${binary}"
          RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(NOT result EQUAL 0)
          message(FATAL_ERROR "${shape}/${response} action failed: ${argv}\n${out}\n${err}")
        endif()
      endif()
    endforeach()
    if(response)
      file(GLOB response_files "${binary}/CMakeFiles/reprobuild/rsp/*.rsp")
      list(LENGTH response_files response_count)
      if(NOT response_count EQUAL 14)
        message(FATAL_ERROR "Expected 14 compiler response files, saw ${response_count}")
      endif()
      foreach(rsp_file IN LISTS response_files)
        file(READ "${rsp_file}" rsp)
        if(shape MATCHES "^no-")
          if(rsp MATCHES "aarch64-unknown-linux-gnu")
            message(FATAL_ERROR "${shape}: unexpected response-file target: ${rsp}")
          endif()
        elseif(NOT rsp MATCHES "aarch64-unknown-linux-gnu")
          message(FATAL_ERROR "${shape}: response-file target missing: ${rsp}")
        endif()
      endforeach()
    endif()
    if(NOT count EQUAL 14)
      message(FATAL_ERROR "Expected 8 compile and 6 link actions, saw ${count}: ${provider}")
    endif()
  endforeach()
endforeach()
